'use strict';
var list = document.querySelector('.gallery__list');
list.addEventListener('click', function(e) {
    e.preventDefault();
    var listItem = e.target.closest('.list-item');
    var link = listItem.querySelector('a');
    var galery = document.querySelector('#largeImg');
    galery.src = link.href;
});

